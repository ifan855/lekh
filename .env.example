# ---------------------------------------------------------------------------
# lekh — environment
# ---------------------------------------------------------------------------

# Neon Postgres (direct endpoint, not the pooler)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.c-xxx.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.c-xxx.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-with-openssl-rand-base64-32

# Neon Object Storage (S3 compatible)
S3_ENDPOINT=https://br-xxx.storage.c-xxx.aws.neon.tech
S3_REGION=us-east-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Neon Realtime
NEON_REALTIME_URL=https://br-xxx-neonrealtimesocket.compute.c-xxx.aws.neon.tech/
NEON_REALTIME_SECRET=

# Neon API (lets admins configure the Resend email provider from the admin panel)
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=

# Comma-separated emails that get the admin role on first sign-in
ADMIN_EMAILS=you@example.com

# Email delivery lives entirely in Neon Auth (configure the SMTP provider from
# the admin panel: Admin → Settings → Email delivery). Nothing email-related
# belongs in this file.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MCP_URL=
